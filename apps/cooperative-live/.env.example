# Convex development deployment. Created by `npx convex dev`.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Convex-only teacher dashboard passcode (8+ chars). Set it in the Convex deployment
# with `npx convex env set TEACHER_PASSCODE ...`; never commit the real value.
# Changing it signs out every teacher login.
TEACHER_PASSCODE=

# Convex-only HMAC secret for short-lived manual join attempt buckets (32+ chars).
JOIN_ATTEMPT_HMAC_SECRET=

# Local synthetic-data walkthrough. Never enable in Production.
NEXT_PUBLIC_DEMO_MODE=true
