# Convex development deployment. Created by `npx convex dev`.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Auth0 Single Page Application values for teacher login.
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=

# The same values must also be configured in the Convex deployment.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=

# Comma-separated Auth0 subject identifiers allowed to manage classes.
TEACHER_AUTH0_SUBS=

# Local synthetic-data walkthrough. Never enable in Production.
NEXT_PUBLIC_DEMO_MODE=true
